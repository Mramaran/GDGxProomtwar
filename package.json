{
  "name": "hotseat",
  "private": true,
  "version": "1.0.0",
  "description": "HotSeat: can you defend your resume? AI interviewer that grills every resume claim and paints a defensibility heatmap.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
