# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Used ONLY by the local data script (scripts/distill_companies.py). Never exposed to the browser.
GEMINI_API_KEY=
# Optional, data script only: comma-separated institution-specific words to strip from the source data.
REDACT_TERMS=

# Firebase web app config: Firebase console → Project settings → Your apps → Web app.
# These identify the project; they are not secrets, but we still keep them out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Analytics for Firebase
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: App Check with reCAPTCHA Enterprise (site key)
VITE_RECAPTCHA_SITE_KEY=

# Optional: override the Gemini models (quality = reads the resume, fast = interview turns and fix plans)
VITE_GEMINI_MODEL=gemini-3.8-flash
VITE_GEMINI_FAST_MODEL=gemini-3.5-flash-lite
